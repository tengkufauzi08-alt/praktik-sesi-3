let totalBelanja = 150000;
let diskon = 0;

if (totalBelanja >= 250000) {
    diskon = 0.10; // Diskon 10%
} else if (totalBelanja >= 100000) {
    diskon = 0.05; // Diskon 5%
} else if (totalBelanja >= 50000) {
    diskon = 0.03; // Diskon 3%
} else {
    diskon = 0;    // Selain itu tidak dapat diskon
}

let jumlahDiskon = totalBelanja * diskon;
let totalBayar = totalBelanja - jumlahDiskon;

console.log("Total belanja anda adalah Rp " + totalBelanja);
console.log("Diskon yang anda peroleh Rp " + jumlahDiskon);
console.log("Total yang harus di bayar Rp " + totalBayar);
